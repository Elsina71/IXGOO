# Copia questo file in .env e compila i valori.
# URL pubblico dell'app: serve per i link nelle email e nel QR code.
BASE_URL=https://spedizioni.ixgoo.gr
PORT=5050

# Server email (senza SMTP_HOST le email vengono salvate in data/outbox e
# sono consultabili su /dev/posta)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@ixgoo.gr
SMTP_PASSWORD=
MAIL_FROM=IxGoo Courier <noreply@ixgoo.gr>

# Account creati al primo avvio
ADMIN_EMAIL=admin@ixgoo.gr
ADMIN_PASSWORD=cambiami-subito
COURIER_EMAIL=courier@ixgoo.gr
COURIER_PASSWORD=cambiami-subito
